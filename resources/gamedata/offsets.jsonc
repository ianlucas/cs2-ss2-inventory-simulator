{
  // 1. Find the CCSPlayerInventory vtable (see CCSPlayerInventory::GetItemInLoadout in
  //    signatures.jsonc).
  // 2. Take the function at index 3 (SOCacheSubscribed), it stores its cache argument with
  //    *(_QWORD *)(inventory + offset) = cache.
  // 3. To confirm, the function at index 14 on Linux and 13 on Windows (SOCacheUnsubscribed) sets
  //    the same field to 0.
  "CCSPlayerInventory::m_pSOCache": {
    "windows": 104,
    "linux": 104
  },
  // 1. Find the GCSDK::CGCClientSharedObjectCache vtable.
  //    Linux: _ZTVN5GCSDK26CGCClientSharedObjectCacheE, functions start 0x10 after it.
  //    Windows: xref ??_R4CGCClientSharedObjectCache@GCSDK@@6B@, functions start 8 bytes after
  //    that xref.
  // 2. Take the function at index 2 on Linux and 1 on Windows (GetOwner), it returns the SOID_t at
  //    the offset.
  "CGCClientSharedObjectCache::m_Owner": {
    "windows": 40,
    "linux": 40
  },
  // The value is relative to m_nPersonaDataXpTrailLevel's schema offset, so it follows layout
  // changes on its own.
  // 1. Find CChicken::InitPet (see signatures.jsonc).
  // 2. It calls a small function that returns the controller's m_pInventoryServices, then a small
  //    function that calls GetItemInLoadout(services + offset, 0, 57).
  // 3. The inventory is embedded in the services at the offset, it isn't a pointer.
  // 4. The value is that offset minus m_nPersonaDataXpTrailLevel's schema offset.
  "CCSPlayerController_InventoryServices::m_pInventory": {
    "linux": 4,
    "windows": 4
  },
  // The value is relative to m_bSpawnDyingParticles's schema offset, so it follows layout changes
  // on its own.
  // 1. Find CCSChickenManager::ServerGamePostSimulate (see signatures.jsonc).
  // 2. Look for the loop through the "chicken" entities that have an owner.
  // 3. It does *(_BYTE *)(chicken + offset) = 0;
  // 4. To confirm, search for the "has set desired activity" string, the chicken functions using it
  //    check *(_BYTE *)(chicken + offset) before allowing walk, run, glide and land.
  // 5. The value is that offset minus m_bSpawnDyingParticles's schema offset.
  "CChicken::m_bCanRoam": {
    "linux": -1,
    "windows": -1
  },
  // 1. Search for the "Prohibiting %s\n" string, its only xref is the mp_items_prohibited callback.
  // 2. For each item in the ConVar, it compares the definition's index, a word at the offset.
  "CEconItemDefinition::m_nDefIndex": {
    "linux": 16,
    "windows": 16
  },
  // 1. Find the mp_items_prohibited callback (see CEconItemDefinition::m_nDefIndex).
  // 2. It prints the definition's name, a pointer at the offset, with "Prohibiting %s\n".
  "CEconItemDefinition::m_pszDefinitionName": {
    "linux": 608,
    "windows": 608
  },
  // 1. Find CCSPlayerPawn::SetModelFromLoadout (see signatures.jsonc).
  // 2. It checks the agent's definition with cmp dword ptr [def + offset], 26h
  //    (LOADOUT_SLOT_CLOTHING_CUSTOMPLAYER).
  "CEconItemDefinition::m_iDefaultLoadoutSlot": {
    "linux": 824,
    "windows": 824
  }
}
